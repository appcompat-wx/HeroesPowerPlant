  </ImportGroup>
  <ImportGroup Condition=" '$(TargetFramework)' == 'netcoreapp3.1' AND '$(ExcludeRestorePackageImports)' != 'true' ">
    <Import Project="$(NuGetPackageRoot)propertychanged.fody\4.1.0\build\PropertyChanged.Fody.props" Condition="Exists('$(NuGetPackageRoot)propertychanged.fody\4.1.0\build\PropertyChanged.Fody.props')" />
    <Import Project="$(NuGetPackageRoot)equals.fody\4.0.2\build\Equals.Fody.props" Condition="Exists('$(NuGetPackageRoot)equals.fody\4.0.2\build\Equals.Fody.props')" />
  </ImportGroup>
  <ImportGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' AND '$(ExcludeRestorePackageImports)' != 'true' ">
    <Import Project="$(NuGetPackageRoot)propertychanged.fody\4.1.0\build\PropertyChanged.Fody.props" Condition="Exists('$(NuGetPackageRoot)propertychanged.fody\4.1.0\build\PropertyChanged.Fody.props')" />
    <Import Project="$(NuGetPackageRoot)equals.fody\4.0.2\build\Equals.Fody.props" Condition="Exists('$(NuGetPackageRoot)equals.fody\4.0.2\build\Equals.Fody.props')" />
